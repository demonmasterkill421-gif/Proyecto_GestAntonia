# Entorno virtual y secretos
venv/
.venv/
.env
.env.local

# Python
__pycache__/
*.py[cod]

# Bases de datos locales y archivos generados
db.sqlite3
staticfiles/
media/

# Editores y sistema
.vscode/
.idea/
.dbeaver/
.project
.settings/
Thumbs.db
.DS_Store

# Llaves y respaldos del servidor
*.pem
*.dump

# Caché de Django (límite de intentos del login)
.cache_django/

# Carpeta deploy: respaldos de la base, copias del .env y scripts locales NO se suben.
# Solo se versiona el script de despliegue (el servidor lo descarga desde main).
deploy/*
!deploy/deploy_gestantonia.sh
